<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
    	 <record id="view_stock_update_internal_tree" model="ir.ui.view">
            <field name="name">stock.update.internal.tree</field>
            <field name="model">stock.update.internal</field>
            <field name="arch" type="xml">
                <tree string="Cập nhật phiếu xuất kho" version="7.0">                    
                        <field name="phieu_id" />                      
                        <field name="ngay_capnhat" />
                        <field name="date_done" />
                        <field name="user_id" />
                 </tree>
            </field>
        </record>    
        <record id="view_stock_update_internal_form" model="ir.ui.view">
            <field name="name">stock.update.internal.from</field>
            <field name="model">stock.update.internal</field>
            <field name="arch" type="xml">
                <form string="Cập nhật phiếu xuất kho" version="7.0">
                    <group >
	                    <group>
	                         <field name="ngay_capnhat"  />
	                         <field name="date_done"/>
	                    </group>
	                    <group>
	                          <field name="user_id" readonly="1"/>
                   		 </group>                      
                      </group>                        
                    <footer>
                        <div>
                            <button name="action_correct_delivery" string="Cập nhật" type="object" class="oe_highlight"/> or
                            <button special="cancel" string="Hủy" class="oe_link"/>
                        </div>
                    </footer>
                 </form>
            </field>
        </record>   
	<record id="action_stock_update_internal" model="ir.actions.act_window">
               <field name="name">Cập nhật phiếu xuất kho</field>
               <field name="type">ir.actions.act_window</field>
               <field name="res_model">stock.update.internal</field>
               <field name="view_type">form</field>
               <field name="view_mode">form</field>
               <field name="view_id" ref="view_stock_update_internal_form"/>
               <field name="context">{'record_id' : active_id}</field>
               <field name="target">new</field>
        </record>
          <record id="view_stock_update_internal_form2" model="ir.ui.view">
            <field name="name">stock.update.internal.form2</field>
            <field name="model">stock.update.internal</field>
            <field name="arch" type="xml">
                <form string="Cập nhật phiếu xuất kho" version="7.0">
                     <group >
	                    <group>
	                         <field name="ngay_capnhat" readonly="1" />
	                         <field name="date_done" readonly="1"/>
	                    </group>
	                    <group>
	                          <field name="user_id" readonly="1"/>
                   		 </group>                      
                     </group>      
                 </form>
            </field>
        </record>   
        <record id="action_stock_update_internal_lichsu" model="ir.actions.act_window">
               <field name="name">Cập nhật phiếu xuất kho</field>
               <field name="type">ir.actions.act_window</field>
               <field name="res_model">stock.update.internal</field>
               <field name="view_type">form</field>               
               <field name="view_mode">tree,form</field>
                 <field name="view_id" ref="view_stock_update_internal_form2"/>
               
        </record>
         <record id="view_stock_update_internal_tree2" model="ir.actions.act_window.view">
            <field eval="1" name="sequence"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_stock_update_internal_tree"/>
            <field name="act_window_id" ref="action_stock_update_internal_lichsu"/>
        </record>
        <record id="action_stock_update_lichsu_form2" model="ir.actions.act_window.view">
            <field eval="2" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_stock_update_internal_form2"/>
            <field name="act_window_id" ref="action_stock_update_internal_lichsu"/>
        </record>
	  <menuitem action="action_stock_update_internal_lichsu" id="menu_action_stock_update_internal_lichsu" name="Lịch sử sửa phiếu nội bộ" parent="stock.menu_lichsu" sequence="2" groups="stock.group_stock_user_edit" /> 	
	  
    </data>
</openerp>
