<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
    
        <record id="view_icsc_kehoach_update_form" model="ir.ui.view">
            <field name="name">icsc.kehoach.update.from</field>
            <field name="model">icsc.kehoach.update</field>
            <field name="arch" type="xml">
                <form string="Cập nhật kế hoạch vận chuyển" version="7.0">
                    <sheet>
                    <group >
	                    <group>
	                     <field name="kehoach_id" readonly="1"  />                           
                         <field name="trung_chuyen" readonly="1"  /> 
                          <field name="state" readonly="1"  /> 
                          <field name="user_id" readonly="1" />
                          <field name="kiem_soat" />
                          <field name="loai_khvc" />
                          <field name="giam_sat_kho" />
                          
	                    </group>
	                    <group>
	                     <field name="ngay_capnhat" />
	                      <field name="congty_vc"  on_change="load_hop_dong(congty_vc)" attrs="{'invisible': [('state','in',('process','done'))]}" />
	                      <field name="so_khvc"  attrs="{'invisible': [('state','in',('process','done'))]}" />
	                      <field name="cuoc_tu_diem"  attrs="{'invisible': [('trung_chuyen','=',True)]}" />  
                          <field name="cuoc_den_diem" attrs="{'invisible': [('trung_chuyen','=',True)]}"/> 
	                      <field name="phuongthuc_vc"  />
	                      <field name="ngay_lap"  />
	                    </group>
                                          
                       
                    </group>
                     <field name="line_ids">
                     	<tree string="Chi tiết vận chuyển"  editable="bottom" >		
					                	<field name="name" readonly="1"/> 	  
					                	 <field name="product_id" readonly="1"/> 
					                    <field name="kl_vc_dukien"  sum="total" readonly="1" invisible="1" />  
					                    <field name="kl_vc_kehoach" sum="total"  /> 					                   
					                    <field name="kl_dangvc_dukien"  sum="total" readonly="1"/>  
					                     <field name="kl_vc_conlai" sum="total"  readonly="1"/>   
					                     <field name="dia_chi_giao" readonly="1"/>  		                 
					                </tree>
					                 <form string="Chi tiết vận chuyển"  vertion="7.0"> 		
					                	<sheet>
						                	
							                 <group>
								                 <group>
								                     
								                      <field name="name" readonly="1"/> 
								                       <field name="kl_vc_dukien" readonly="1"/> 
								                      <field name="kl_vc_kehoach"  /> 
								                     	<field name="kl_dangvc_dukien" readonly="1"/>                      
								                  </group>
								                   <group>
								                      <field name="product_id" readonly="1"/>			                   	 
								                      <field name="kl_can_vanchuyen" readonly="1" /> 
								                       <field name="kl_vc_conlai" readonly="1" /> 		                     
								                       <field name="dia_chi_giao" readonly="1" /> 	
								                   </group>
							                 </group>	
		                 					      	               
	                					 </sheet> 
	              
					                </form>
                     </field>
                      <field name="dien_giai" placeholder="Ghi chú..."/>  
                    </sheet>
                    
                    <footer>
                        <div>
                            <button name="action_correct_delivery" string="Cập nhật" type="object" class="oe_highlight"/> or
                            <button special="cancel" string="Hủy" class="oe_link"/>
                        </div>
                    </footer>
                 </form>
            </field>
        </record>   
	<record id="action_icsc_kehoach_update" model="ir.actions.act_window">
               <field name="name">Cập nhật kế hoạch vận chuyển</field>
               <field name="type">ir.actions.act_window</field>
               <field name="res_model">icsc.kehoach.update</field>
               <field name="view_type">form</field>
               <field name="view_mode">form</field>
               <field name="context">{'record_id' : active_id}</field>
               <field name="target">new</field>
        </record>
          <record id="action_view_icsc_kehoach_update_form3" model="ir.actions.act_window.view">
            <field eval="0" name="sequence"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_icsc_kehoach_update_form"/>
            <field name="act_window_id" ref="action_icsc_kehoach_update"/>
        </record> 
