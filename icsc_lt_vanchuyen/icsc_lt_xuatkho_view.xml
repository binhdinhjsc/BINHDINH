	               	  <field name="location_id" string="Kho xuất" />
	            </xpath>
	        	<xpath expr="//field[@name='location_dest_id']"  position="replace">	            	
<!-- 	               	 <field name="location_dest_id" string="Địa điểm đích"  attrs="{'readonly': ['|',('sale_line_id', '!=', False),('chitiet_kh', '!=', False)]}"/> -->
