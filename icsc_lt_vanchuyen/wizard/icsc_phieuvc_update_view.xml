					     <form string="Chi tiết vận chuyển" version="7.0" >						          
							<field name="name" readonly="1"/> 	  
		                	<field name="product_id" readonly="1"/> 
		                    <field name="kl_vc"  readonly="1" />  
		                    <field name="diem_den"  readonly="1" /> 
		                    <field name="thue_id"  readonly="1" /> 								                   
		                    <field name="thanh_tien" />    
		                     		                 
					     </form>
					 </field>
					            
                    </sheet>                    
                   
                 </form>
            </field>
        </record>           
         <record id="action_view_icsc_phieuvc_update_form2_lichsu" model="ir.actions.act_window">
