	                      <field name="so_khvc"  attrs="{'invisible': [('state','in',('process','done'))]}" readonly="1"  />
	                      <field name="cuoc_tu_diem"  attrs="{'invisible': [('trung_chuyen','=',True)]}" readonly="1"  />  
