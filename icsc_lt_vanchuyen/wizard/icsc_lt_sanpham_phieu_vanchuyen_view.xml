<openerp>
      <data>

        <record id="view_icsc_lt_phieutungphan" model="ir.ui.view">
            <field name="name">Danh sách sản phẩm của phiếu vận chuyển</field>
            <field name="model">icsc.lt.phieutungphan</field>
            <field name="arch" type="xml">
                <form string="Danh sách sản phẩm của phiếu vận chuyển" version="7.0" >
                    <group>  
                   
                                
                        <field name="phieu_id" />
                         <field name="ngay_lap" />
                       
                    </group>
                     <field name = "line_ids">
                        
                            <tree string="Sản phẩm" editable="bottom" create="0">
                                <field name="product_id" string="Sản phẩm"/>
                                <field name="kl_vc" />
                             </tree>
                            <form string="Sản phẩm" version="7.0" >
                                <field name="product_id" string="Sản phẩm"/>
                                <field name="kl_vc" />
                            </form>
                        </field>
                    <footer>
                        <button name="tao_phieu" string="Đồng ý" type="object" class="oe_highlight"/>
                        or
                        <button string="Hủy bỏ" class="oe_link" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_icsc_lt_phieutungphan" model="ir.actions.act_window">
               <field name="name">Danh sách sản phẩm đã vận chuyển</field>
               <field name="type">ir.actions.act_window</field>
               <field name="res_model">icsc.lt.phieutungphan</field>
               <field name="view_type">form</field>
               <field name="view_mode">form</field>
               <field name="context">{'record_id' : active_id}</field>
               <field name="target">new</field>
        </record>
        
        
     
</data>
</openerp>


