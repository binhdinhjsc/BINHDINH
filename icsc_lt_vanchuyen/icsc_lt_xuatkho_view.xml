<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>    
    <record id="view_vpicktree_form" model="ir.ui.view">
          <field name="name">stock.picking.out.tree</field>
          <field name="model">stock.picking.out</field>
          <field name="inherit_id" ref="stock.view_picking_out_tree"/>
          <field name="arch" type="xml"> 
          <xpath expr="//field[@name='partner_id']"  position="after">	            	
	          <field name="sale_id" attrs="{'readonly': [('state', '=', 'done')]}" string="Lệnh xuất hàng"/>
	          <field name="tong_khoiluong"/> 
	          <field name="haiduong_id" invisible="1"/> 
	          <field name="ngay_giao" invisible="1"/> 
          </xpath>   
           <xpath expr="//field[@name='origin']"  position="replace">	            	
             	<field name="origin" invisible="1"/>
             	<field name="loai_vanchuyen" invisible="1"/>
                <field name="type_kho" invisible="1"/>
                <field name="kehoach_vanchuyen_id" invisible="1"/>
             	<field name="auto_update_name" invisible="1"/>
            </xpath>   
            <xpath expr="//field[@name='stock_journal_id']"  position="replace">	            	
                <field name="don_vi_vc"/>
                <field name="donvi_vanchuyen" invisible="1"/>
                <field name="dai_dien" invisible="1"/>
            </xpath>   
             <xpath expr="//field[@name='backorder_id']"  position="replace">	            	
               <field name="backorder_id" invisible="1"/>
            </xpath>  
                             
	 		</field>
	 </record>
	  <record id="view_view_picking_in_search_form12" model="ir.ui.view">
          <field name="name">stock.picking.in.search12</field>
            <field name="model">stock.picking.in</field>
            <field name="inherit_id" ref="stock.view_picking_in_search"/>
            <field name="arch" type="xml">  
            <xpath expr="//search/group/filter[@name='state']"  position="after">	            	
               <filter string="Đơn vị thực hiện" icon="terp-stock_effects-object-colorize" domain="[]" context="{'group_by':'haiduong_id'}"/>
            </xpath>   
                        
	 		</field>
	 </record>
	 
	  <record id="view_view_picking_in_tree12" model="ir.ui.view">
          <field name="name">stock.picking.in.tree12</field>
            <field name="model">stock.picking.in</field>
            <field name="inherit_id" ref="stock.view_picking_in_tree"/>
            <field name="arch" type="xml">  
            <xpath expr="//field[@name='state']"  position="after">	            	
                <field name="haiduong_id" invisible="1"/>
            </xpath>   
                        
	 		</field>
	 </record>
	 <record id="view_view_picking_form_internal" model="ir.ui.view">
          <field name="name">stock.picking.internal.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
             <xpath expr="/form/header//button[@string='Reverse Transfer']"  position="replace">
             	<button name="%(stock.act_stock_return_picking)d" attrs="{'invisible': [('type', '=', 'internal')]}" string="Reverse Transfer"  type="action" groups="base.group_stock_user_return"/>
             </xpath>  
             <xpath expr="/form/header//button[@string='Sửa PXK']"  position="replace">
             	<button name="%(stock.action_stock_update)d" attrs="{'invisible': ['|',('type', '=', 'internal'),('state','not in',('done'))]}" string="Sửa PXK" type="action" groups="stock.group_stock_user_edit"/>	  
             	<button name="%(action_stock_update_internal)d" attrs="{'invisible': [('type', '!=', 'internal')]}" string="Sửa PXK" type="action" groups="stock.group_stock_user_edit"/>	 
             </xpath>  
            <xpath expr="//field[@name='move_lines']"  position="replace">	            	
                 <field name="move_lines" context="{'address_in_id': partner_id, 'form_view_ref':'view_move_picking_form', 'tree_view_ref':'view_move_picking_tree', 'picking_type': 'internal'}"  options='{"reload_on_button": true}'>
                          	 <tree  string="Stock Moves" >
                          		<field name="check"/>
			                    <field name="product_id"/>
			                    <field name="product_qty" on_change="onchange_quantity(product_id, product_qty, product_uom, product_uos)" />
			                    <field name="product_uom" string="Đơn vị" groups="product.group_uom"/>
			                    <field name="location_id" groups="stock.group_locations" string="Kho xuất"/>
			                    <field name="picking_id" invisible="1" />
			                    <field name="create_date" invisible="1" />
			                    <field name="date_expected" invisible="1" />
			 					<field name="product_uos" invisible="1" />
			                      <field name="location_dest_id" groups="stock.group_locations" string="Kho gửi" />
			                      <field name="state"/>
			                </tree>
				            <form string="Stock Moves" version="7.0">
				                <header>
				                        <button name="force_assign" states="confirmed" string="Force Availability" type="object" groups="base.group_user"/>
				                        <button name="action_confirm" states="draft" string="Confirm" type="object" groups="base.group_user"/>
				                        <button name="cancel_assign" states="assigned" string="Cancel Availability" type="object" groups="base.group_user"/>
				                        <field name="state" widget="statusbar" statusbar_visible="draft,assigned,done"/>
				                </header>
				                <group>
				                    <group>
				                    	<field name="check" />
				                        <field name="name" invisible="1"/>
				                        <field name="product_id" on_change="onchange_product_id(product_id,location_id,location_dest_id, parent.partner_id)"/>
				                        <field name="type" invisible="1"/>
				                        <label for="product_qty"/>
				                        <div>
				                            <field name="product_qty" on_change="onchange_quantity(product_id, product_qty, product_uom, product_uos)" class="oe_inline"/>
				                            <field name="product_uom" string="Unit Of Measure" groups="product.group_uom" class="oe_inline"/>
				                        </div>
				                            <field name="product_uos" invisible="1" />
				                            <field name="partner_id"/>
				                     </group>
				                            <group>
				                                <field name="create_date" invisible="1"/>
				                                <field name="date"/>
				                                <field name="date_expected" on_change="onchange_date(date,date_expected)"/>
				                            </group>
				
				                            <group string="Locations" groups="stock.group_locations">
				                                <field name="location_id" />
				                                <field name="location_dest_id"  groups="stock.group_locations"/>
				                            </group>
				
				                    </group>
				                </form>
				        </field>
				                           
            </xpath>   
                        
	 		</field>
	 </record>
    	 <record id="view_picking_out_search_replace_vc" model="ir.ui.view">
            <field name="name">stock.picking.out.inherit.select.vc</field>
            <field name="model">stock.picking.out</field>
            <field name="inherit_id" ref="stock.view_picking_out_search"/>
            <field name="arch" type="xml">
                 <xpath expr="//search"  position="replace">
                    <search string="Phiếu xuất kho">
                    <field name="sale_id" string="Lệnh xuất hàng" filter_domain="[('sale_id','ilike',self)]"/>
                    <field name="name" string="Phiếu xuất kho" filter_domain="['|',('name','ilike', self),('origin','ilike',self)]"/>
                    <filter icon="terp-check" name="sẵn sàng giao hàng" string="Ready" domain="[('state','=','assigned')]" help="Assigned Delivery Orders"/>
                    <filter icon="terp-camera_test" name="Đang đợi" string="Waiting" domain="[('state','=','confirmed')]" help="Confirmed Delivery Orders"/>
                    <filter icon="terp-dialog-close" name="Hoàn tất" string="Done" domain="[('state','=','done')]" help="Delivery orders already processed"/>
                    <separator/>
                    <filter icon="terp-accessories-archiver-minus" string="Phiếu xuất kho nguồn" domain="[('backorder_id', '!=', False)]" help="Is a Back Order"/>
                    <separator/>
                    <filter icon="terp-dolar" name="to_invoice" string="To Invoice" domain="[('invoice_state','=','2binvoiced')]" help="Delivery orders to invoice"/>
                    <separator/>
                    <filter icon="terp-accessories-archiver-minus" name="tong_khoiluong" string="Có số lượng" domain="[('tong_khoiluong', '!=', 0)]" help="Tổng khối lượng lớn hơn 0"/>
                    <filter icon="terp-accessories-archiver-minus" string="Không có số lượng" domain="[('tong_khoiluong', '=', 0)]" help="Tổng khối lượng bằng 0"/>
                    <separator/>
                    <field name="partner_id" filter_domain="[('partner_id','child_of',self)]"/>
                   
                    <field name="don_vi_vc" filter_domain="[('don_vi_vc','ilike',self)]"/>
                    <field name="stock_journal_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    
                    <group expand="0" string="Group By...">
                        <filter string="Status" icon="terp-stock_effects-object-colorize" domain="[]" context="{'group_by':'state'}"/>
                        <filter string="Ngày đặt" icon="terp-go-month" domain="[]"  context="{'group_by':'date'}"/>
                        <filter string="Ngày dự kiến" icon="terp-go-month" domain="[]"  context="{'group_by':'min_date'}"/>
                        <filter string="Nhật ký" icon="terp-folder-orange" domain="[]" context="{'group_by':'stock_journal_id'}"/>
                        <filter string="Lệnh xuất hàng" icon="terp-folder-orange" domain="[]" context="{'group_by':'sale_id'}"/>
                        <filter string="Khách hàng" icon="terp-folder-orange" domain="[]" context="{'group_by':'partner_id'}"/>
                         <filter string="Đơn vị vận chuyển" icon="terp-folder-orange" domain="[]" context="{'group_by':'donvi_vanchuyen'}"/>
                        <filter string="Kế hoạch vận chuyển" icon="terp-folder-orange" domain="[]" context="{'group_by':'kehoach_vanchuyen_id'}"/>
                        <filter string="Loại vận chuyển" icon="terp-folder-orange" domain="[]" context="{'group_by':'loai_vanchuyen'}"/>
                        <filter string="Loại xuất kho" icon="terp-folder-orange" domain="[]" context="{'group_by':'loai_xuatkho'}"/>
                        <filter string="Loại hình kho" icon="terp-folder-orange" domain="[]" context="{'group_by':'type_kho'}"/>
                        <filter string="Đơn vị thực hiện" icon="" domain="[]" context="{'group_by':'haiduong_id'}"/>
                        <filter string="Ngày giao" icon="" domain="[]" context="{'group_by':'ngay_giao'}"/>
                  
                    </group>
                </search>
                </xpath>
            </field>
        </record>
        
        
    	 <record id="stock_picking_inherit_vc" model="ir.ui.view">
            <field name="name">stock.picking.inherit.form.vc</field>
            <field name="model">stock.picking.out</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
             
                 <field name="move_type" position="after">
                 	<field name="kehoach_vanchuyen_id" attrs="{'readonly': [('state', '=', 'done')]}"/>  
                    <field name="doitac_giaohang" on_change="load_ma_vung(partner_id,doitac_giaohang)" attrs="{'readonly': [('state', '=', 'done')]}"/>	            
                	<field name="don_vi_vc" attrs="{'readonly': [('state', '=', 'done')]}"/>
	               	<field name="dai_dien" attrs="{'readonly': [('state', '=', 'done')]}"/>
	             	 
                </field>
               <xpath expr="//notebook"  position="inside">	
               	    <page string="Phiếu vận chuyển liên quan" attrs="{'invisible': [('kehoach_vanchuyen_id', '=', False)]}" >
               	    		<field name="pvc_ids" attrs="{'invisible': [('kehoach_vanchuyen_id', '=', False)]}" />
               	    </page>        	
	           </xpath>
            </field>
        </record>
 
		<record id="view_picking_out_form_form" model="ir.ui.view">
          <field name="name">stock.picking.out.form</field>
            <field name="model">stock.picking.out</field>
            <field name="inherit_id" ref="stock.view_picking_out_form"/>
            <field name="arch" type="xml"> 
              <xpath expr="/form/header//button[@name='action_process']" position="replace">
                  <button name="action_process"  string="Giao hàng" type="object" class="oe_highlight"
                  attrs="{'invisible': ['|','|',('state','!=','assigned'),('bang_kiem_soat','=',False),('daidien_muahang','=',False)]}"/>
             </xpath>  
                              
	        	<xpath expr="//field[@name='stock_journal_id']"  position="after">	            	
	               	   <field name="auto_update_name" invisible="1"/>
                       <field name="daidien_muahang" attrs="{'readonly': [('state', '=', 'done')]}" context="{'default_parent_id': partner_id}"/>   
                       <field name="loai_vanchuyen" attrs="{'readonly': [('state', '=', 'done')]}"/> 
                       <field name="loai_lenh_vc"  class="oe_highlight_vanchuyen"/>
	        	</xpath>
	        	 <xpath expr="//notebook" position="before">
                  <group>
                  	<group>
                  		<field name="bang_kiem_soat" required="1"/> 
                  	</group>
                  	<group>
                  		<field name="is_npp"/>
                  		<field name="npp_id" attrs="{'invisible': [('is_npp', '=', False)]}"/>
                  		<field name="npp_delivery_id" on_change="onchange_npp_id(npp_id, npp_delivery_id)" domain="[('parent_other_id','=', npp_id)]" attrs="{'invisible': [('is_npp', '=', False)]}"/>
                  		<field name="npp_mavung" attrs="{'invisible': [('is_npp', '=', False)]}"/> 
                  	</group>
                  	<group>
                  		<field name="bang_kiem_soat" required="1"/> 
                  	</group>					
                  </group>
                </xpath>
	        	<xpath expr="//field[@name='origin']"  position="after">	            	
	               	  <field name="so_theo_doi_vc" invisible="1"/>
	               	
                      <field name="khoxuat_id" attrs="{'readonly': [('sale_id', '!=', False)]}"/>  
                      <field name="ma_vung" attrs="{'readonly': [('state', '=', 'done')]}"/>        
  					   <field name="type_kho" attrs="{'readonly': [('sale_id', '!=', False)]}"/>    
	        	</xpath>
	        	<xpath expr="//field[@name='auto_picking']"  position="after">	            	
	               	 <field name="hoa_don_id"/>	               	                
                      
	        	</xpath>
	        	 <xpath expr="//field[@name='partner_id']" position="replace">
                    <field name="partner_id" attrs="{'readonly': [('sale_id', '!=', False)]}"  on_change="onchange_partner_in(partner_id)" string="Khách hàng" domain="[('customer','=',True)]" />
                	  
                </xpath>
           
             
            </field>   
         </record>	   
         
         <record id="view_move_picking_form_inherit_form1" model="ir.ui.view">
           <field name="name">stock.move.inherit.form</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_form"/>
            <field name="arch" type="xml">                
	        	
	        	<xpath expr="//field[@name='partner_id']"  position="after">	            	
	               	 <field name="doitac_giaohang" attrs="{'readonly': [('state', '=', 'done')]}"/>
	               	        
                      
	        	</xpath>
            </field>   
         </record>	   
           
           <record id="view_move_picking_tree_inherit_form" model="ir.ui.view">
           <field name="name">stock.move.tree</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_picking_tree"/>
            <field name="arch" type="xml">                
	        	<xpath expr="//field[@name='product_id']"  position="before">	            	
