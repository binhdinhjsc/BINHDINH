	                      <field name="phuongthuc_vc"  readonly="1"/>
	                      <field name="ngay_lap" readonly="1" />
	                    </group>
                                 
                    </group>
                     <field name="line_ids" readonly="1">
                     	<tree string="Chi tiết vận chuyển"  editable="bottom" >		
					                	<field name="name" readonly="1"/> 	  
					                	 <field name="product_id" readonly="1"/> 
					                    <field name="kl_vc_dukien"  sum="total" readonly="1" string="KL ban đầu"/>  
					                    <field name="kl_vc_kehoach" sum="total" string="KL sửa đổi" /> 					                   
					                    <field name="kl_dangvc_dukien"  sum="total" readonly="1"/>    
					                     <field name="dia_chi_giao" readonly="1"/>  		                 
					                </tree>
					                 <form string="Chi tiết vận chuyển"  vertion="7.0"> 		
					                	<sheet>
						                	
							                 <group>
								                 <group>
								                     
								                      <field name="name" readonly="1"/> 
								                       <field name="kl_vc_dukien" readonly="1" /> 
								                      <field name="kl_vc_kehoach"  /> 
								                     	<field name="kl_dangvc_dukien" readonly="1"/>                      
								                  </group>
								                   <group>
								                      <field name="product_id" readonly="1"/>			                   	 
								                      <field name="kl_can_vanchuyen" readonly="1" /> 
								                       <field name="kl_vc_conlai" readonly="1" /> 		                     
								                       <field name="dia_chi_giao" readonly="1" /> 	
								                   </group>
							                 </group>	
		                 					      	               
	                					 </sheet> 
	              
					                </form>
                     </field>
                      <field name="dien_giai" placeholder="Ghi chú..."/>  
                    </sheet>                    
                   
                 </form>
            </field>
        </record>           
