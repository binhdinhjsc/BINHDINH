        <record id="view_view_picking_form_form23" model="ir.ui.view">
          <field name="name">stock.picking.in.form23</field>
            <field name="model">stock.picking.in</field>
            <field name="inherit_id" ref="stock.view_picking_in_form"/>
            <field name="arch" type="xml">                  
	        	<xpath expr="//field[@name='partner_id']"  position="after">	            	
                       <field name="dv_thuchien"/> 
	        	</xpath>
	        	<xpath expr="//field[@name='move_lines']"  position="replace">	            	
                      <field name="move_lines" context="{'address_in_id': partner_id, 'picking_type': 'in'}" options='{"reload_on_button": true}'>
	                      <tree  string="Stock Moves" editable="bottom">
	                      	<field name="check"/>
		               	    <field name="no"/>
		               	    <field name="sale_line_id" string="Chi tiết LXH"/>
		               	    <field name="chitiet_kh" invisible="1"/>
		                    <field name="product_id" on_change="onchange_product_id(product_id,location_id,location_dest_id, False)" attrs="{'readonly': ['|',('sale_line_id', '!=', False),('chitiet_kh', '!=', False)]}"/>
		                    <field name="product_qty" on_change="onchange_quantity(product_id, product_qty, product_uom, product_uos)" attrs="{'readonly': ['|',('sale_line_id', '!=', False),('chitiet_kh', '!=', False)]}"/>
		                    <field name="product_uom" string="Đơn vị" groups="product.group_uom"/>
		                    <field name="product_uos" string="Đơn vị" groups="product.group_uos" invisible="1"/>
		                    <field name="doitac_giaohang" attrs="{'readonly': ['|',('sale_line_id', '!=', False),('chitiet_kh', '!=', False)]}"/>
	               	  		<field name="location_id" string="Kho xuất" />
		                    <field name="picking_id" invisible="1" />
		                    <field name="create_date" invisible="1" />
		                    <field name="date_expected" invisible="1" />
		                    <field name="location_dest_id" string="Địa điểm đích"/>
		                    <field name="state"/>
                		</tree>
                      </field>
                
	        	</xpath>
       	</field>
       	</record>
